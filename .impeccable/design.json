      "html": "<div class=\"ds-kstamps\"><span class=\"ds-ks ds-pass\">&#10003; PASS</span><span class=\"ds-ks ds-warn\">WARN</span><span class=\"ds-ks ds-fail\">&#10005; FAIL</span><span class=\"ds-ks ds-unk\">UNKNOWN</span></div>",
      "css": ".ds-kstamps{display:flex;gap:12px;background:#fff;padding:12px}.ds-ks{height:40px;line-height:40px;padding:0 18px;border-radius:20px;font:700 24px Comfortaa,Carlito,sans-serif}.ds-pass{background:#107c58;color:#fff}.ds-warn{background:#ffc448;color:#3b2142}.ds-fail{background:#c8203c;color:#fff}.ds-unk{background:#ffecf4;color:#3b2142}"
