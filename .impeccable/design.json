  "components": [
    {
      "name": "Mecha bay",
      "kind": "card",
      "refersTo": "mecha-bay",
      "description": "Home tile on the deck: chamfered plate, mono tab, status lamp, icon, caps name. Selected = orange outline, tab and name, hazard strip.",
      "html": "<div class=\"ds-mbay\" tabindex=\"0\"><span class=\"ds-mbay-tab\">01</span><span class=\"ds-mbay-lamp\"></span><span class=\"ds-mbay-name\">HDD / SSD</span></div>",
      "css": ".ds-mbay{position:relative;width:148px;height:132px;background:#3e3e48;clip-path: polygon(19px 0, 100% 0, 100% calc(100% - 19px), calc(100% - 19px) 100%, 0 100%, 0 19px);font-family:'Bebas Neue',Carlito,sans-serif;color:#ecece8;cursor:pointer}.ds-mbay::before{content:'';position:absolute;inset:2px;background:#16161a;clip-path: polygon(18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%, 0 18px);}.ds-mbay-tab{position:absolute;top:8px;left:23px;background:#28282f;color:#9696a0;font:700 17px 'DejaVu Sans Mono',monospace;padding:2px 7px}.ds-mbay-lamp{position:absolute;top:10px;right:10px;width:14px;height:14px;border-radius:50%;background:#39d98a;box-shadow:0 0 0 3px #121216,0 0 0 5px #3e3e48}.ds-mbay-name{position:absolute;bottom:10px;left:0;right:0;text-align:center;font-size:22px}.ds-mbay:hover,.ds-mbay:focus-visible{background:#ff6a00;outline:none}.ds-mbay:hover .ds-mbay-tab,.ds-mbay:focus-visible .ds-mbay-tab{background:#ff6a00;color:#0b0b0d}.ds-mbay:hover .ds-mbay-name,.ds-mbay:focus-visible .ds-mbay-name{color:#ff6a00}"
    },
    {
      "name": "Mecha alert plate (FAIL)",
      "kind": "chip",
      "refersTo": "mecha-plate-fail",
      "description": "Verdict plate: chamfered fill in the verdict colour, TEXT_ON letters; FAIL gets hazard flanks.",
      "html": "<div class=\"ds-mplate\"><i class=\"ds-mhaz\"></i><b>FAIL</b><i class=\"ds-mhaz\"></i></div>",
      "css": ".ds-mplate{display:inline-flex;gap:4px;align-items:center;background:#16161a;padding:8px}.ds-mplate b{display:inline-block;height:40px;line-height:42px;padding:0 18px;background:#ff5c50;color:#0b0b0d;font:700 28px 'Bebas Neue',Carlito,sans-serif;clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);}.ds-mhaz{display:inline-block;width:22px;height:40px;background:repeating-linear-gradient(135deg,#ffc400 0 7px,#111113 7px 14px)}"
    },
    {
      "name": "Mecha menu row",
      "kind": "nav",
      "refersTo": "mecha-menu-row-selected",
      "description": "Menu row: steel two-digit number, bone name; selected row is a chamfered orange fill with TEXT_ON text.",
      "html": "<div class=\"ds-mmenu\"><button class=\"ds-mrow\"><span>01</span><b>1 minute</b><em>quick sanity check</em></button><button class=\"ds-mrow ds-on\"><span>02</span><b>5 minutes</b><em>normal check</em></button></div>",
      "css": ".ds-mmenu{background:#16161a;padding:12px;width:520px}.ds-mrow{display:flex;gap:18px;width:100%;border:0;background:none;padding:8px 14px;font:22px Carlito,sans-serif;color:#ecece8;text-align:left;cursor:pointer}.ds-mrow span{font:20px 'DejaVu Sans Mono',monospace;color:#9696a0}.ds-mrow em{font-style:normal;color:#9696a0}.ds-mrow.ds-on,.ds-mrow:hover,.ds-mrow:focus-visible{background:#ff6a00;color:#0b0b0d;outline:none;clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);}.ds-mrow.ds-on span,.ds-mrow:hover span,.ds-mrow:focus-visible span{color:#0b0b0d;font-weight:700}.ds-mrow.ds-on em,.ds-mrow:hover em,.ds-mrow:focus-visible em{color:#482209}"
    },
    {
      "name": "Mecha segmented gauge",
      "kind": "custom",
      "refersTo": "mecha-bay",
      "description": "Progress as block segments (~14 px pitch, 3 px gap, 16 tall); lit in ACCENT, unlit in TAB, percentage in mono muted.",
      "html": "<div class=\"ds-mgauge\"><div class=\"ds-mgauge-track\"></div><span>62%</span></div>",
      "css": ".ds-mgauge{display:flex;align-items:center;gap:16px;background:#16161a;padding:12px;width:520px}.ds-mgauge-track{flex:1;height:16px;background:repeating-linear-gradient(90deg,transparent 0 11px,#16161a 11px 14px),linear-gradient(90deg,#ff6a00 62%,#28282f 62%)}.ds-mgauge span{font:20px 'DejaVu Sans Mono',monospace;color:#9696a0}"
    },
    {
      "name": "Kawaii sticker",
      "kind": "card",
      "refersTo": "kawaii-sticker",
      "description": "Home tile on the sheet: white rounded sticker on lavender backing, round number badge, result stamp, violet icon, plum name. Selected = violet fill, white text, deeper backing.",
