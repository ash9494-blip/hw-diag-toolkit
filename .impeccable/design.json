    "typographyMeta": {
      "body": {
        "displayName": "Body",
        "purpose": "Carlito 22: prose lines, badge descriptions, status names (steps to 18/15)."
      },
      "body-small": {
        "displayName": "Small",
        "purpose": "Carlito 18: footer hint and YES/NO help line on both skins."
      },
      "body-tiny": {
        "displayName": "Tiny",
        "purpose": "Carlito 15: machine model / CPU lines in the header."
      },
      "number": {
        "displayName": "Number",
        "purpose": "DejaVu Sans Mono Bold 17 (mono_m): tabs, badges, readouts, result words."
      },
      "number-label": {
        "displayName": "Number label",
        "purpose": "DejaVu Sans Mono 13 (mono_s): readout labels REV / DATE / TIME."
      },
      "mecha-display": {
        "displayName": "Mecha display",
        "purpose": "Bebas Neue Bold 46 caps, 1 px tracking: home, card and animation titles (card title capped at x1.15 text scale)."
      },
      "mecha-header": {
        "displayName": "Mecha header",
        "purpose": "Bebas Neue Bold 34 caps, 1.5 px tracking: toolkit name in the command bar."
      },
      "mecha-plate": {
        "displayName": "Mecha plate",
        "purpose": "Bebas Neue Bold 28: verdict plates, YES/NO, SYSTEM STATUS."
      },
      "mecha-bay-name": {
        "displayName": "Mecha bay name",
        "purpose": "Bebas Neue Bold caps, ladder 28/25/22/19 x ts + 23/21/19/17 x s; largest that fits."
      },
      "mecha-tag": {
        "displayName": "Mecha tag",
        "purpose": "Bebas Neue Regular 22: LIVE chip."
      },
      "kawaii-display": {
        "displayName": "Kawaii display",
        "purpose": "Comfortaa Bold 30: band name, home, card and animation titles (card title capped at x1.15)."
      },
      "kawaii-stamp": {
        "displayName": "Kawaii stamp",
        "purpose": "Comfortaa Bold 24: result stamps, YES/NO, Checklist heading."
      },
      "kawaii-sticker-name": {
        "displayName": "Kawaii sticker name",
        "purpose": "Comfortaa Bold, ladder 19/17/15/13 x ts + 17/15/13/11 x s."
      },
      "kawaii-chip": {
        "displayName": "Kawaii chip",
        "purpose": "Comfortaa Bold 15 (steps to 12): stamps on stickers and in the Checklist, LIVE chip."
      }
    },
